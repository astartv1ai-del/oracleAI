# DOMAIN is supplied through ../.env. Caddy provisions the HTTPS certificate.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Paddle signatures cover the raw request body; proxy it without rewriting.
	handle /api/webhooks/* {
		request_body {
			max_size 512KB
		}
		reverse_proxy api:8080
	}

	handle {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8080 {
			health_uri /api/health
			health_interval 30s
		}
	}
}
