# ──────────────────────────────────────────────────────────────
# БОЕВОЙ КОНФИГ «Оракул» — заполни и скопируй в .env на сервере
# Набор идентичен .env.example; здесь — только то, что критично
# поменять, чтобы запустить под наплывом пользователей.
# ──────────────────────────────────────────────────────────────

# Telegram. ADMIN_ID — твой числовой id (@userinfobot): без него
# в панель управления будет не войти.
BOT_TOKEN=
ADMIN_ID=

# https-адрес Mini App: домен из infra/Caddyfile (A-запись → IP VPS).
# Caddy сам выпустит сертификат. Без него кнопка WebApp не появится.
WEBAPP_URL=
DOMAIN=

# ⚠️ ОБЯЗАТЕЛЬНО 0 на боевом сервере: DEV_MODE=1 пускает в API
# любого по ?dev_user=<id> без подписи Telegram — это открытый вход
# в админ-панель и чужие данные.
DEV_MODE=0

# LLM. auto = цепочка custom → anthropic → openai, затем офлайн.
# Должен быть настроен хотя бы один живой провайдер: без него
# продукт работает в офлайн-режиме (шаблонные трактовки).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Свой OpenAI-совместимый сервер (vLLM/LM Studio/Ollama/прокси).
# НА БОЕВОМ СЕРВЕРЕ НЕ ДОЛЖНО быть localhost-адреса — только реальный
# доступный хост. Локальный прокси, выключенный на машине разработчика,
# selfcheck помечает как предупреждение, но живой запрос к нему не пойдёт.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_MODEL_LITE=

# Модели по уровням: main — ответы клиентке, lite — фон (память, прогнозы)
ANTHROPIC_MODEL_MAIN=claude-sonnet-4-6
ANTHROPIC_MODEL_LITE=claude-haiku-4-5
OPENAI_MODEL_MAIN=gpt-5
OPENAI_MODEL_LITE=gpt-5-mini

# ──────────── web-оплата подписки (Paddle / LemonSqueezy) ──────
# Комиссия 3-5% против ~30-40% у Telegram Stars. Вебхук приходит на
# https://твой-домен/api/webhooks/paddle — заполни секрет перед
# включением флага web_payments в админке.
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_API_URL=https://api.paddle.com
PADDLE_CHECKOUT_URL=
# Server-side map; example: vip:pri_...,basic:pri_...
PADDLE_PRICE_IDS=

# ─────────────── каналы-спутники с гороскопами ─────────────────
# По каналу на знак: код_знака:@канал через запятую. Автопостинг
# включается флагом horoscope_channels в админке.
# HOROSCOPE_CHANNELS=aries:@oracle_aries,taurus:@oracle_taurus
HOROSCOPE_CHANNELS=

# ───────────────────────── окружение ───────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
LLM_MAX_CONCURRENCY=8
LLM_RATE_PER_MIN=240
LLM_WORKFLOW_TIMEOUT=90
LLM_MAX_TOOL_CALLS=12
LLM_MAX_COST_USD=0.25
# Уникальный commit/tag для поиска проблем в structured logs.
RELEASE_ID=
# Оставь пустым: DATA_DIR в Docker = /opt/oracle/data (см. infra/Dockerfile)
DATA_DIR=
DB_PATH=
PUBLIC_URL=
# Пусто = JSONL только в stdout контейнера; путь должен быть writable.
LOG_FILE=

# ──────────────── мониторинг: Sentry (пусто = выключен) ─────────
SENTRY_DSN=

# ──────────────── off-site encrypted backup (S3-совместимый) ────
# Ключ не коммитить и не передавать через чат. Создай его на host:
#   install -m 600 /dev/null /etc/oracle/backup.key
#   openssl rand -base64 48 > /etc/oracle/backup.key
# Compose монтирует его через BACKUP_ENCRYPTION_KEY_HOST_PATH.
BACKUP_ENCRYPTION_KEY_HOST_PATH=/etc/oracle/backup.key
BACKUP_REQUIRE_ENCRYPTION=1
BACKUP_KEEP=14
BACKUP_S3_URL=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1

# ──────────────── продуктовые значения по умолчанию ────────────
# Рабочие значения живут в БД и правятся в админке; эти — на первый старт.
TRIAL_DAYS=30
TRIAL_CRYSTALS=30

# ──────────────────── проверка перед запуском ──────────────────
# python -m scripts.selfcheck   → все ✅ (LLM-проверка на реальном сервере)
# docker compose -f infra/docker-compose.yml up -d --build
# Процессов ровно два: планировщик и рассылки живут ТОЛЬКО в процессе бота,
# API масштабируется свободно. Не поднимай второй бот — клиентки получат
# каждое сообщение дважды.
