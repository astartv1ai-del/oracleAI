# ─────────────────────────── Telegram ───────────────────────────
# Токен у @BotFather. ADMIN_ID — твой числовой id (@userinfobot):
# без него в панель управления будет не войти.
BOT_TOKEN=123456:ABC...
ADMIN_ID=

# https-адрес Mini App. Локально: cloudflared tunnel --url http://localhost:8080
# Без него кнопка «Открыть Оракула» в боте не появится.
WEBAPP_URL=
DOMAIN=

# ─────────────────────────── LLM ────────────────────────────────
# auto — цепочка отказоустойчивости custom → anthropic → openai,
# затем офлайн-режим. Можно зафиксировать один: custom|anthropic|openai|off
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Любой OpenAI-совместимый сервер: vLLM, LM Studio, Ollama serve, прокси
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_MODEL_LITE=

# Модели по уровням: main — ответы клиентке, lite — фон (память, прогнозы)
ANTHROPIC_MODEL_MAIN=claude-sonnet-4-6
ANTHROPIC_MODEL_LITE=claude-haiku-4-5
OPENAI_MODEL_MAIN=gpt-5
OPENAI_MODEL_LITE=gpt-5-mini

# ──────────────────── память по смыслу (необязательно) ──────────
# Без эмбеддингов память ищется по словам — продукт работает, но хуже
# вспоминает к месту. EMBED_VIA_CUSTOM=1 — считать на своём сервере.
EMBED_MODEL=text-embedding-3-small
EMBED_VIA_CUSTOM=0

# ──────────────── озвучка прогнозов (тариф «Консьерж») ──────────
# Нужен ключ OpenAI. Без него тариф деградирует до текста, не до ошибки.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=shimmer

# ─────────────── каналы-спутники с гороскопами ──────────────────
# По каналу на знак: код_знака:@канал через запятую. Автопостинг
# дополнительно включается флагом horoscope_channels в админке.
# HOROSCOPE_CHANNELS=aries:@oracle_aries,taurus:@oracle_taurus
HOROSCOPE_CHANNELS=

# ──────────── web-оплата подписки (Paddle / LemonSqueezy) ───────
# Комиссия 3-5% против ~30-40% у Telegram Stars — основной чек идёт сюда.
# Вебхук: https://твой-домен/api/webhooks/paddle
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_API_URL=https://api.paddle.com
PADDLE_CHECKOUT_URL=
# Server-side map; example: vip:pri_...,basic:pri_...
PADDLE_PRICE_IDS=

# ───────────────────────── окружение ────────────────────────────
# DEV_MODE=1 пускает в API любого по ?dev_user=<id> БЕЗ подписи Telegram.
# На боевом сервере обязательно 0.
DEV_MODE=0
LOG_LEVEL=INFO
LLM_MAX_CONCURRENCY=8
LLM_RATE_PER_MIN=240
LLM_WORKFLOW_TIMEOUT=90
LLM_MAX_TOOL_CALLS=12
LLM_MAX_COST_USD=0.25
DATA_DIR=
DB_PATH=
# Set DATABASE_URL to switch production runtime to PostgreSQL.
# Example: postgresql+asyncpg://oracle:password@db:5432/oracle
DATABASE_URL=
PGVECTOR_ENABLED=1
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=10
PG_POOL_TIMEOUT=30
# SQLite scaling knobs; defaults are safe for the single-file WAL deployment.
SQLITE_BUSY_TIMEOUT_MS=15000
SQLITE_WAL_AUTOCHECKPOINT=2000
SQLITE_CACHE_SIZE_KB=16000
PUBLIC_URL=

# ──────────────── продуктовые значения по умолчанию ─────────────
# Рабочие значения живут в БД и правятся в админке; эти нужны на первом старте.
TRIAL_DAYS=30
TRIAL_CRYSTALS=30
